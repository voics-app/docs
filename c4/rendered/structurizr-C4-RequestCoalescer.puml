@startuml
title <size:24>Component View: Voics - messages</size>\n<size:24>Code view: request coalescing of identical concurrent history reads.</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("Voics_boundary", "Voics", $tags="") {
  Container_Boundary("Voics.messages_boundary", "messages", $tags="") {
    Component(Voics.messages.Messageusecases, "Message use cases", $techn="Rust", $descr="Create, edit, delete, bulk delete, react, pin, ack, history; 409/50160 for non-standard channels.", $tags="", $link="")
    Component(Voics.messages.CoalescerKV, "Coalescer<K, V>", $techn="generic struct", $descr="get_or_load(key, loader): joins an in-flight future or starts one; removes the entry on completion.", $tags="", $link="")
    Component(Voics.messages.InFlightmap, "InFlight map", $techn="DashMap", $descr="DashMap<K, Shared<BoxFuture<Result<V, E>>>>.", $tags="", $link="")
    Component(Voics.messages.HistoryQuery, "HistoryQuery", $techn="struct (Hash + Eq)", $descr="Coalescing key: channel_id, bucket, before/after/around, limit.", $tags="", $link="")
    Component(Voics.messages.CoalescingMessageRepository, "CoalescingMessageRepository", $techn="struct", $descr="Decorator implementing MessageRepository; routes reads through the coalescer, writes straight through.", $tags="", $link="")
    Component(Voics.messages.MessageRepository, "MessageRepository", $techn="trait", $descr="Port used by the history use case.", $tags="", $link="")
    Component(Voics.messages.ScyllaMessageRepository, "ScyllaMessageRepository", $techn="struct", $descr="Adapter executing the prepared CQL statement.", $tags="", $link="")
    Component(Voics.messages.GetHistory, "GetHistory", $techn="struct", $descr="Use case: walks buckets backwards until limit or the channel's first bucket.", $tags="", $link="")
  }

}

Rel(Voics.messages.GetHistory, Voics.messages.MessageRepository, "Depends on", $techn="", $tags="", $link="")
Rel(Voics.messages.CoalescingMessageRepository, Voics.messages.MessageRepository, "Implements", $techn="", $tags="", $link="")
Rel(Voics.messages.ScyllaMessageRepository, Voics.messages.MessageRepository, "Implements", $techn="", $tags="", $link="")
Rel(Voics.messages.CoalescingMessageRepository, Voics.messages.CoalescerKV, "Routes reads through", $techn="", $tags="", $link="")
Rel(Voics.messages.CoalescingMessageRepository, Voics.messages.ScyllaMessageRepository, "Delegates loads and writes to", $techn="", $tags="", $link="")
Rel(Voics.messages.CoalescerKV, Voics.messages.InFlightmap, "Joins or inserts shared futures in", $techn="", $tags="", $link="")
Rel(Voics.messages.CoalescerKV, Voics.messages.HistoryQuery, "Keyed by", $techn="", $tags="", $link="")
Rel(Voics.messages.Messageusecases, Voics.messages.GetHistory, "Executes", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml