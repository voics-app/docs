@startuml
title <size:24>System Context View: Discordy</size>\n<size:24>Who uses Discordy and which external systems it depends on.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>

Person(User, "User", $descr="Chats, talks, streams and watches together using the desktop client.", $tags="", $link="")
System(Discordy, "Discordy", $descr="Real-time chat, voice, video and screen share with three delivery modes.", $tags="", $link="")
Person(Botdeveloper, "Bot developer", $descr="Builds bots with bots-sdk against the REST API and the gateway.", $tags="", $link="")
Person(Platformadmin, "Platform admin", $descr="Operates the platform through the admin portal and Headlamp.", $tags="", $link="")
System(Cloudflare, "Cloudflare", $descr="Tunnel, DNS for voics.nl, TLS (Universal SSL) and Access.", $tags="", $link="")
System(GitHub, "GitHub", $descr="Source, Actions, GHCR images, org/environment secrets.", $tags="", $link="")
System(Notion, "Notion", $descr="Read-only mirror of the docs repo.", $tags="", $link="")
System(Ownersrouter, "Owner's router", $descr="Forwards UDP 50000 (SFU) and UDP 3478 (coturn) to the cluster node.", $tags="", $link="")
System(Thirdpartybot, "Third-party bot", $descr="A bot built on bots-sdk, run by a bot developer.", $tags="", $link="")
System(1Password, "1Password", $descr="Holds the OpenBao unseal keys and root token.", $tags="", $link="")

Rel(User, Discordy, "Chats, calls, streams", $techn="HTTPS, WSS, UDP", $tags="", $link="")
Rel(Botdeveloper, Thirdpartybot, "Writes and runs", $techn="", $tags="", $link="")
Rel(Thirdpartybot, Discordy, "Calls REST API, connects to gateway", $techn="HTTPS, WSS", $tags="", $link="")
Rel(Platformadmin, Discordy, "Operates via admin portal and Headlamp", $techn="HTTPS", $tags="", $link="")
Rel(Discordy, Cloudflare, "Exposed through tunnel; DNS records managed via API", $techn="HTTPS", $tags="", $link="")
Rel(Ownersrouter, Discordy, "Forwards voice media and TURN", $techn="UDP 50000, UDP/TCP 3478", $tags="", $link="")
Rel(GitHub, Discordy, "Builds images, syncs secrets, Flux source", $techn="HTTPS", $tags="", $link="")
Rel(Discordy, Notion, "Docs mirrored on merge to main", $techn="HTTPS", $tags="", $link="")
Rel(Platformadmin, 1Password, "Retrieves unseal keys", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml