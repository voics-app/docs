@startuml
title <size:24>Component View: Voics - gateway</size>\n<size:24>gateway components.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("Voics_boundary", "Voics", $tags="") {
  Container_Boundary("Voics.gateway_boundary", "gateway", $tags="") {
    Component(Voics.gateway.Gatewaysocket, "Gateway socket", $techn="Phoenix socket", $descr="/gateway?v=1&encoding=json transport; close codes 4000-4014.", $tags="", $link="")
    Component(Voics.gateway.Protocolcodec, "Protocol codec", $techn="Elixir", $descr="Encodes/decodes {op, d, s, t} frames for every P7 opcode.", $tags="", $link="")
    Component(Voics.gateway.InternalHTTP, "Internal HTTP", $techn="Plug", $descr="Admin stats, voice node drain/undrain.", $tags="", $link="")
    Component(Voics.gateway.Session, "Session", $techn="GenServer", $descr="GenServer per connection: identify, heartbeat, sequence, resume buffer, 120/60 s rate limit.", $tags="", $link="")
    Component(Voics.gateway.Guildprocess, "Guild process", $techn="GenServer", $descr="GenServer per guild: members, roles, channels, permission cache, voice state.", $tags="", $link="")
    Component(Voics.gateway.Guildregistry, "Guild registry", $techn="Horde / :pg", $descr="Cluster-wide process registry and lazy start.", $tags="", $link="")
    Component(Voics.gateway.Fanout, "Fan-out", $techn="Elixir", $descr="Filters recipients by VIEW_CHANNEL and intents; dispatches to sessions.", $tags="", $link="")
    Component(Voics.gateway.Permissioncalculator, "Permission calculator", $techn="Elixir (domain)", $descr="Port of api's algorithm, tested with the same tables.", $tags="", $link="")
    Component(Voics.gateway.Presence, "Presence", $techn="Elixir", $descr="Aggregates a user's sessions; PRESENCE_UPDATE to guilds and friends.", $tags="", $link="")
    Component(Voics.gateway.Voiceallocator, "Voice allocator", $techn="GenServer", $descr="Picks the least-utilised healthy voice node in the guild's region; reallocates on loss.", $tags="", $link="")
    Component(Voics.gateway.Voicestateregistry, "Voice-state registry", $techn="Elixir", $descr="Who is in which voice channel; VOICE_STATE_UPDATE fan-out.", $tags="", $link="")
    Component(Voics.gateway.E2EEinbox, "E2EE inbox", $techn="Elixir", $descr="Per-device ciphertext streams, ACK deletion, 7-day TTL sweeper, replay after READY.", $tags="", $link="")
    Component(Voics.gateway.P2Prelay, "P2P relay", $techn="Elixir", $descr="Relays op 22 to online devices only; never persists.", $tags="", $link="")
    Component(Voics.gateway.WatchTogetherrelay, "Watch Together relay", $techn="Elixir", $descr="Relays op 24 with the server clock.", $tags="", $link="")
    Component(Voics.gateway.Eventconsumers, "Event consumers", $techn="brod", $descr="One consumer group per topic; P6 routing; 10k-entry dedup LRU.", $tags="", $link="")
    Component(Voics.gateway.apiclient, "api client", $techn="Req", $descr="ready, guild state, channel access, introspect.", $tags="", $link="")
    Component(Voics.gateway.Valkeyadapter, "Valkey adapter", $techn="Redix", $descr="gw:*, e2ee:*, voice:*, presence:* keys.", $tags="", $link="")
    Component(Voics.gateway.etcdwatcher, "etcd watcher", $techn="eetcd", $descr="Watches /discordy/voice/nodes/.", $tags="", $link="")
    Component(Voics.gateway.Telemetrypublisher, "Telemetry publisher", $techn="brod", $descr="VOICE_TELEMETRY and USAGE_TICK to discordy.telemetry.v1.", $tags="", $link="")
  }

  ContainerQueue(Voics.Redpanda, "Redpanda", $techn="Redpanda 25.x (Kafka API)", $descr="Event bus: discordy.{guild,message,user,interaction,telemetry,audit}.v1.", $tags="", $link="")
  ContainerDb(Voics.Valkey, "Valkey", $techn="Valkey 8", $descr="Resume buffers, presence, rate limits, voice allocations, E2EE inboxes (AOF on).", $tags="", $link="")
  ContainerDb(Voics.etcd, "etcd", $techn="etcd 3.6", $descr="Voice-server discovery under leased keys.", $tags="", $link="")
  Container(Voics.api, "api", $techn="Rust, Axum, SQLx", $descr="Auth, users, devices, relationships, guilds, channels, roles, permissions, invites, bots, interactions, webhooks, MLS key packages, admin endpoints; transactional outbox.", $tags="", $link="")
}

Rel(Voics.api, Voics.Redpanda, "Publishes guild, user, interaction, audit events", $techn="Kafka", $tags="", $link="")
Rel(Voics.api, Voics.Valkey, "Rate limits and caches", $techn="RESP", $tags="", $link="")
Rel(Voics.gateway.Gatewaysocket, Voics.gateway.Protocolcodec, "Decodes/encodes frames with", $techn="", $tags="", $link="")
Rel(Voics.gateway.Gatewaysocket, Voics.gateway.Session, "Starts one per connection", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.apiclient, "Fetches ready payload, introspects bot tokens", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.Valkeyadapter, "Resume buffer gw:resume:<session_id>", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.Guildregistry, "Subscribes to guilds via", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.Presence, "Reports status to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.Voicestateregistry, "Forwards op 4 to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.E2EEinbox, "Forwards op 20/21 to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.P2Prelay, "Forwards op 22 to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.WatchTogetherrelay, "Forwards op 24 to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Session, Voics.gateway.Telemetrypublisher, "Forwards op 23 to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Guildregistry, Voics.gateway.Guildprocess, "Locates or starts", $techn="", $tags="", $link="")
Rel(Voics.gateway.Guildprocess, Voics.gateway.apiclient, "Loads guild state", $techn="", $tags="", $link="")
Rel(Voics.gateway.Guildprocess, Voics.gateway.Permissioncalculator, "Computes VIEW_CHANNEL with", $techn="", $tags="", $link="")
Rel(Voics.gateway.Guildprocess, Voics.gateway.Fanout, "Dispatches through", $techn="", $tags="", $link="")
Rel(Voics.gateway.Guildprocess, Voics.gateway.Voiceallocator, "Allocates voice server via", $techn="", $tags="", $link="")
Rel(Voics.gateway.Fanout, Voics.gateway.Session, "Delivers DISPATCH to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Eventconsumers, Voics.gateway.Guildregistry, "Routes guild events to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Eventconsumers, Voics.gateway.Fanout, "Routes targeted events to", $techn="", $tags="", $link="")
Rel(Voics.gateway.Presence, Voics.gateway.Valkeyadapter, "presence:*", $techn="", $tags="", $link="")
Rel(Voics.gateway.Presence, Voics.gateway.Fanout, "Publishes PRESENCE_UPDATE through", $techn="", $tags="", $link="")
Rel(Voics.gateway.Voicestateregistry, Voics.gateway.Guildprocess, "Tracks state in", $techn="", $tags="", $link="")
Rel(Voics.gateway.Voiceallocator, Voics.gateway.etcdwatcher, "Discovers nodes via", $techn="", $tags="", $link="")
Rel(Voics.gateway.Voiceallocator, Voics.gateway.Valkeyadapter, "voice:alloc:<srv_id>", $techn="", $tags="", $link="")
Rel(Voics.gateway.E2EEinbox, Voics.gateway.Valkeyadapter, "e2ee:inbox:<device_id>, e2ee:ttl", $techn="", $tags="", $link="")
Rel(Voics.gateway.E2EEinbox, Voics.gateway.Fanout, "Delivers envelopes through", $techn="", $tags="", $link="")
Rel(Voics.gateway.P2Prelay, Voics.gateway.Fanout, "Delivers signals through", $techn="", $tags="", $link="")
Rel(Voics.gateway.WatchTogetherrelay, Voics.gateway.Fanout, "Delivers sync events through", $techn="", $tags="", $link="")
Rel(Voics.gateway.InternalHTTP, Voics.gateway.Voiceallocator, "Drain/undrain", $techn="", $tags="", $link="")
Rel(Voics.gateway.InternalHTTP, Voics.gateway.Guildregistry, "Stats", $techn="", $tags="", $link="")
Rel(Voics.gateway.apiclient, Voics.api, "Calls", $techn="HTTP /internal/v1", $tags="", $link="")
Rel(Voics.gateway.Eventconsumers, Voics.Redpanda, "Consumes", $techn="Kafka", $tags="", $link="")
Rel(Voics.gateway.Telemetrypublisher, Voics.Redpanda, "Publishes", $techn="Kafka", $tags="", $link="")
Rel(Voics.gateway.Valkeyadapter, Voics.Valkey, "RESP", $techn="", $tags="", $link="")
Rel(Voics.gateway.etcdwatcher, Voics.etcd, "Watches", $techn="gRPC", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml