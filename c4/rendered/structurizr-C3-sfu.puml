@startuml
title <size:24>Component View: Voics - sfu</size>\n<size:24>SFU components.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("Voics_boundary", "Voics", $tags="") {
  Container_Boundary("Voics.sfu_boundary", "sfu", $tags="") {
    Component(Voics.sfu.UDPmux, "UDP mux", $techn="tokio UdpSocket", $descr="Single socket on UDP 50000.", $tags="", $link="")
    Component(Voics.sfu.Sessiondemux, "Session demux", $techn="Rust", $descr="Routes datagrams by ICE ufrag (STUN) then by source address.", $tags="", $link="")
    Component(Voics.sfu.Peersession, "Peer session", $techn="str0m", $descr="One str0m Rtc per client: ICE-lite, DTLS-SRTP, RTP/RTCP.", $tags="", $link="")
    Component(Voics.sfu.Roomtable, "Room table", $techn="Rust", $descr="Sessions per room, published tracks, subscriptions.", $tags="", $link="")
    Component(Voics.sfu.Forwardingengine, "Forwarding engine", $techn="Rust", $descr="Forwards audio to every other member; selects video layers per subscriber.", $tags="", $link="")
    Component(Voics.sfu.RTCPhandler, "RTCP handler", $techn="Rust", $descr="Terminates/forwards NACK, PLI, REMB, TWCC.", $tags="", $link="")
    Component(Voics.sfu.Speakingdetector, "Speaking detector", $techn="Rust", $descr="Audio-level header extension to speaking events.", $tags="", $link="")
    Component(Voics.sfu.Controlserver, "Control server", $techn="tokio TcpListener", $descr="NDJSON on 127.0.0.1:4101: create_session, close_session, set_sink_wants.", $tags="", $link="")
    Component(Voics.sfu.Stats, "Stats", $techn="Rust", $descr="Per-session bitrate/loss, Prometheus metrics.", $tags="", $link="")
  }

  Container(Voics.voicesignaling, "voice-signaling", $techn="Elixir, Phoenix", $descr="Voice WebSocket, media setup, speaking indicators, DAVE MLS relay, etcd registration, SFU supervision.", $tags="", $link="")
}

Rel(Voics.sfu.UDPmux, Voics.sfu.Sessiondemux, "Hands datagrams to", $techn="", $tags="", $link="")
Rel(Voics.sfu.Sessiondemux, Voics.sfu.Peersession, "Feeds the owning session", $techn="", $tags="", $link="")
Rel(Voics.sfu.Peersession, Voics.sfu.Forwardingengine, "Emits media packets to", $techn="", $tags="", $link="")
Rel(Voics.sfu.Peersession, Voics.sfu.RTCPhandler, "Emits feedback to", $techn="", $tags="", $link="")
Rel(Voics.sfu.Peersession, Voics.sfu.Speakingdetector, "Emits audio levels to", $techn="", $tags="", $link="")
Rel(Voics.sfu.Forwardingengine, Voics.sfu.Roomtable, "Looks up subscribers in", $techn="", $tags="", $link="")
Rel(Voics.sfu.Forwardingengine, Voics.sfu.Peersession, "Writes rewritten packets to subscribers", $techn="", $tags="", $link="")
Rel(Voics.sfu.RTCPhandler, Voics.sfu.Forwardingengine, "Updates bandwidth estimates and requests keyframes", $techn="", $tags="", $link="")
Rel(Voics.sfu.Controlserver, Voics.sfu.Roomtable, "Creates/closes sessions, sets sink wants", $techn="", $tags="", $link="")
Rel(Voics.sfu.Controlserver, Voics.sfu.Peersession, "Creates", $techn="", $tags="", $link="")
Rel(Voics.sfu.Speakingdetector, Voics.sfu.Controlserver, "Emits speaking events through", $techn="", $tags="", $link="")
Rel(Voics.sfu.Stats, Voics.sfu.Peersession, "Samples", $techn="", $tags="", $link="")
Rel(Voics.sfu.Controlserver, Voics.voicesignaling, "Replies with session_created, speaking, stats", $techn="NDJSON", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml