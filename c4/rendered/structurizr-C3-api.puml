@startuml
title <size:24>Component View: Discordy - api</size>\n<size:24>api components (Clean Architecture layers).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("Discordy_boundary", "Discordy", $tags="") {
  Container_Boundary("Discordy.api_boundary", "api", $tags="") {
    Component(Discordy.api.PublicREST, "Public REST", $techn="axum", $descr="/api/v1 routers, DTO mapping, Discord-style error envelope.", $tags="", $link="")
    Component(Discordy.api.InternalREST, "Internal REST", $techn="axum", $descr="/internal/v1: introspect, ready, guild state, channel access, admin.", $tags="", $link="")
    Component(Discordy.api.Authratelimitmiddleware, "Auth & rate-limit middleware", $techn="axum extractors", $descr="Bearer/Bot token extraction, X-Internal-Token check, X-RateLimit-* headers.", $tags="", $link="")
    Component(Discordy.api.Authusecases, "Auth use cases", $techn="Rust", $descr="Register, login, TOTP, refresh rotation with reuse detection, logout, introspect.", $tags="", $link="")
    Component(Discordy.api.Userusecases, "User use cases", $techn="Rust", $descr="Profiles, settings, relationships, DMs, devices, single-use key-package claims, delivery-mode overrides.", $tags="", $link="")
    Component(Discordy.api.Guildusecases, "Guild use cases", $techn="Rust", $descr="Guilds, channels, roles, members, overwrites, bans, invites, emojis, audit log.", $tags="", $link="")
    Component(Discordy.api.Applicationusecases, "Application use cases", $techn="Rust", $descr="Applications, bot users and tokens, slash commands, OAuth2 bot authorize, interactions, webhooks.", $tags="", $link="")
    Component(Discordy.api.Adminusecases, "Admin use cases", $techn="Rust", $descr="Stats, user search, suspension, guild search.", $tags="", $link="")
    Component(Discordy.api.Permissioncalculator, "Permission calculator", $techn="Rust (domain)", $descr="Discord's algorithm: base permissions, administrator/owner, overwrites, implicit denies.", $tags="", $link="")
    Component(Discordy.api.Deliverymoderesolver, "Delivery-mode resolver", $techn="Rust (domain)", $descr="P11: strictest of participants for DMs, channel setting for guilds, size constraints.", $tags="", $link="")
    Component(Discordy.api.Snowflakegenerator, "Snowflake generator", $techn="Rust (domain)", $descr="42-bit ms since 2026-01-01, 10-bit worker (0-63), 12-bit sequence.", $tags="", $link="")
    Component(Discordy.api.Postgresrepositories, "Postgres repositories", $techn="sqlx", $descr="Implements the repository ports; writes outbox rows in the same transaction.", $tags="", $link="")
    Component(Discordy.api.Outboxrelay, "Outbox relay", $techn="Kafka client", $descr="Polls outbox FOR UPDATE SKIP LOCKED and publishes with an idempotent producer.", $tags="", $link="")
    Component(Discordy.api.Tokenissuer, "Token issuer", $techn="ed25519", $descr="Ed25519 (EdDSA) access JWTs, opaque refresh tokens, bot tokens.", $tags="", $link="")
    Component(Discordy.api.Passwordhasher, "Password hasher", $techn="argon2", $descr="argon2id.", $tags="", $link="")
    Component(Discordy.api.Ratelimiter, "Rate limiter", $techn="redis client", $descr="Token buckets in Valkey (rl:*).", $tags="", $link="")
    Component(Discordy.api.Assetpresigner, "Asset presigner", $techn="S3 client", $descr="Presigned URLs for avatars, icons and emoji in the assets bucket.", $tags="", $link="")
  }

  ContainerDb(Discordy.Postgres, "Postgres", $techn="Postgres 17 (CloudNativePG)", $descr="Relational data (DB discordy, owned by api) and admin rollups (DB discordy_admin).", $tags="", $link="")
  ContainerQueue(Discordy.Redpanda, "Redpanda", $techn="Redpanda 25.x (Kafka API)", $descr="Event bus: discordy.{guild,message,user,interaction,telemetry,audit}.v1.", $tags="", $link="")
  ContainerDb(Discordy.Valkey, "Valkey", $techn="Valkey 8", $descr="Resume buffers, presence, rate limits, voice allocations, E2EE inboxes (AOF on).", $tags="", $link="")
  ContainerDb(Discordy.MinIO, "MinIO", $techn="MinIO (S3 API)", $descr="Assets, attachments and the client update feed.", $tags="", $link="")
  Container(Discordy.messages, "messages", $techn="Rust, Axum, scylla driver", $descr="Standard message CRUD and history, Snowflake IDs, request coalescing, reactions, pins, read states, attachments.", $tags="", $link="")
}

Rel(Discordy.messages, Discordy.Redpanda, "Publishes message events", $techn="Kafka", $tags="", $link="")
Rel(Discordy.messages, Discordy.MinIO, "Presigns attachment uploads", $techn="S3", $tags="", $link="")
Rel(Discordy.api.PublicREST, Discordy.api.Authratelimitmiddleware, "Guarded by", $techn="", $tags="", $link="")
Rel(Discordy.api.InternalREST, Discordy.api.Authratelimitmiddleware, "Guarded by", $techn="", $tags="", $link="")
Rel(Discordy.api.PublicREST, Discordy.api.Authusecases, "Invokes", $techn="", $tags="", $link="")
Rel(Discordy.api.PublicREST, Discordy.api.Userusecases, "Invokes", $techn="", $tags="", $link="")
Rel(Discordy.api.PublicREST, Discordy.api.Guildusecases, "Invokes", $techn="", $tags="", $link="")
Rel(Discordy.api.PublicREST, Discordy.api.Applicationusecases, "Invokes", $techn="", $tags="", $link="")
Rel(Discordy.api.InternalREST, Discordy.api.Authusecases, "Introspect", $techn="", $tags="", $link="")
Rel(Discordy.api.InternalREST, Discordy.api.Guildusecases, "Ready, guild state, channel access", $techn="", $tags="", $link="")
Rel(Discordy.api.InternalREST, Discordy.api.Adminusecases, "Admin endpoints", $techn="", $tags="", $link="")
Rel(Discordy.api.Authratelimitmiddleware, Discordy.api.Ratelimiter, "Consumes tokens from", $techn="", $tags="", $link="")
Rel(Discordy.api.Authratelimitmiddleware, Discordy.api.Tokenissuer, "Verifies tokens with", $techn="", $tags="", $link="")
Rel(Discordy.api.Authusecases, Discordy.api.Passwordhasher, "Hashes and verifies passwords with", $techn="", $tags="", $link="")
Rel(Discordy.api.Authusecases, Discordy.api.Tokenissuer, "Issues tokens with", $techn="", $tags="", $link="")
Rel(Discordy.api.Authusecases, Discordy.api.Postgresrepositories, "Persists sessions and refresh tokens", $techn="", $tags="", $link="")
Rel(Discordy.api.Userusecases, Discordy.api.Deliverymoderesolver, "Resolves effective delivery mode", $techn="", $tags="", $link="")
Rel(Discordy.api.Userusecases, Discordy.api.Postgresrepositories, "Reads/writes", $techn="", $tags="", $link="")
Rel(Discordy.api.Userusecases, Discordy.api.Snowflakegenerator, "Generates ids", $techn="", $tags="", $link="")
Rel(Discordy.api.Guildusecases, Discordy.api.Permissioncalculator, "Authorises with", $techn="", $tags="", $link="")
Rel(Discordy.api.Guildusecases, Discordy.api.Deliverymoderesolver, "Validates channel delivery mode", $techn="", $tags="", $link="")
Rel(Discordy.api.Guildusecases, Discordy.api.Postgresrepositories, "Reads/writes (with outbox)", $techn="", $tags="", $link="")
Rel(Discordy.api.Guildusecases, Discordy.api.Snowflakegenerator, "Generates ids", $techn="", $tags="", $link="")
Rel(Discordy.api.Guildusecases, Discordy.api.Assetpresigner, "Presigns icons and emoji", $techn="", $tags="", $link="")
Rel(Discordy.api.Applicationusecases, Discordy.api.Permissioncalculator, "Checks bot permissions", $techn="", $tags="", $link="")
Rel(Discordy.api.Applicationusecases, Discordy.api.Postgresrepositories, "Reads/writes (with outbox)", $techn="", $tags="", $link="")
Rel(Discordy.api.Applicationusecases, Discordy.api.Tokenissuer, "Issues bot tokens", $techn="", $tags="", $link="")
Rel(Discordy.api.Adminusecases, Discordy.api.Postgresrepositories, "Queries", $techn="", $tags="", $link="")
Rel(Discordy.api.Outboxrelay, Discordy.api.Postgresrepositories, "Claims unsent rows from", $techn="", $tags="", $link="")
Rel(Discordy.api.Postgresrepositories, Discordy.Postgres, "SQL", $techn="sqlx", $tags="", $link="")
Rel(Discordy.api.Outboxrelay, Discordy.Redpanda, "Publishes", $techn="Kafka", $tags="", $link="")
Rel(Discordy.api.Ratelimiter, Discordy.Valkey, "rl:* buckets", $techn="RESP", $tags="", $link="")
Rel(Discordy.api.Assetpresigner, Discordy.MinIO, "Presigns", $techn="S3", $tags="", $link="")
Rel(Discordy.api.Userusecases, Discordy.messages, "Last message ids", $techn="HTTP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml