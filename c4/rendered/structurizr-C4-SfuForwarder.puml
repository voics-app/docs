@startuml
title <size:24>Component View: Voics - sfu</size>\n<size:24>Code view: SFU forwarding, layer selection and RTP rewriting.</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("Voics_boundary", "Voics", $tags="") {
  Container_Boundary("Voics.sfu_boundary", "sfu", $tags="") {
    Component(Voics.sfu.Peersession, "Peer session", $techn="str0m", $descr="One str0m Rtc per client: ICE-lite, DTLS-SRTP, RTP/RTCP.", $tags="", $link="")
    Component(Voics.sfu.Forwarder, "Forwarder", $techn="struct", $descr="on_packet(from, MediaPacket) -> Vec<(SessionId, MediaPacket)>.", $tags="", $link="")
    Component(Voics.sfu.Room, "Room", $techn="struct", $descr="Members, published tracks by SSRC, subscriptions.", $tags="", $link="")
    Component(Voics.sfu.MediaPacket, "MediaPacket", $techn="struct", $descr="ssrc, rid/spatial/temporal layer, seq, timestamp, marker, payload, keyframe flag.", $tags="", $link="")
    Component(Voics.sfu.Subscription, "Subscription", $techn="struct", $descr="Subscriber, source track, current and target layer, rewriter state.", $tags="", $link="")
    Component(Voics.sfu.LayerSelector, "LayerSelector", $techn="struct", $descr="Target layer from MEDIA_SINK_WANTS quality and the subscriber's bandwidth estimate; switches on keyframes.", $tags="", $link="")
    Component(Voics.sfu.SinkWants, "SinkWants", $techn="struct", $descr="Map ssrc -> quality 0-100 from MEDIA_SINK_WANTS.", $tags="", $link="")
    Component(Voics.sfu.BandwidthEstimate, "BandwidthEstimate", $techn="struct", $descr="Latest REMB/TWCC estimate per subscriber.", $tags="", $link="")
    Component(Voics.sfu.RtpRewriter, "RtpRewriter", $techn="struct", $descr="Continuous seq/timestamp across layer switches and DTX gaps; outbound SSRC per subscription.", $tags="", $link="")
  }

}

Rel(Voics.sfu.Forwarder, Voics.sfu.Room, "Looks up subscriptions in", $techn="", $tags="", $link="")
Rel(Voics.sfu.Forwarder, Voics.sfu.MediaPacket, "Routes", $techn="", $tags="", $link="")
Rel(Voics.sfu.Room, Voics.sfu.Subscription, "Holds", $techn="", $tags="", $link="")
Rel(Voics.sfu.Subscription, Voics.sfu.LayerSelector, "Chooses layer with", $techn="", $tags="", $link="")
Rel(Voics.sfu.Subscription, Voics.sfu.RtpRewriter, "Rewrites seq/timestamp with", $techn="", $tags="", $link="")
Rel(Voics.sfu.LayerSelector, Voics.sfu.SinkWants, "Reads desired quality from", $techn="", $tags="", $link="")
Rel(Voics.sfu.LayerSelector, Voics.sfu.BandwidthEstimate, "Caps by", $techn="", $tags="", $link="")
Rel(Voics.sfu.RtpRewriter, Voics.sfu.MediaPacket, "Produces rewritten", $techn="", $tags="", $link="")
Rel(Voics.sfu.Peersession, Voics.sfu.Forwarder, "on_packet", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml