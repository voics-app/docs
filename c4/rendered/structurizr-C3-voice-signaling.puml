@startuml
title <size:24>Component View: Voics - voice-signaling</size>\n<size:24>voice-signaling components.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("Voics_boundary", "Voics", $tags="") {
  Container_Boundary("Voics.voicesignaling_boundary", "voice-signaling", $tags="") {
    Component(Voics.voicesignaling.Voicesocket, "Voice socket", $techn="Phoenix socket", $descr="/voice transport, P8 opcodes.", $tags="", $link="")
    Component(Voics.voicesignaling.Voicecodec, "Voice codec", $techn="Elixir", $descr="Encodes/decodes {op, d} frames.", $tags="", $link="")
    Component(Voics.voicesignaling.Tokenverifier, "Token verifier", $techn="Elixir", $descr="Verifies HS256 voice tokens (node, srv, chn, expiry).", $tags="", $link="")
    Component(Voics.voicesignaling.Roomregistry, "Room registry", $techn="Registry", $descr="Rooms per server/channel, CLIENTS_CONNECT/DISCONNECT, SPEAKING relay.", $tags="", $link="")
    Component(Voics.voicesignaling.Voicesession, "Voice session", $techn="GenServer", $descr="Process per client: IDENTIFY, SELECT_PROTOCOL, SESSION_DESCRIPTION, MEDIA_SINK_WANTS.", $tags="", $link="")
    Component(Voics.voicesignaling.DAVErelay, "DAVE relay", $techn="Elixir", $descr="MLS external sender; relays proposals, commits and welcomes; never sees keys.", $tags="", $link="")
    Component(Voics.voicesignaling.Draincontroller, "Drain controller", $techn="Elixir", $descr="Stops new sessions while keeping existing ones.", $tags="", $link="")
    Component(Voics.voicesignaling.SFUcontrolclient, "SFU control client", $techn="gen_tcp", $descr="NDJSON over TCP 127.0.0.1:4101.", $tags="", $link="")
    Component(Voics.voicesignaling.SFUsupervisor, "SFU supervisor", $techn="Supervisor", $descr="Restarts the SFU and replays create_session for every live session.", $tags="", $link="")
    Component(Voics.voicesignaling.etcdregistrar, "etcd registrar", $techn="eetcd", $descr="Lease (10 s TTL, 3 s refresh) at /discordy/voice/nodes/<region>/<node_id> with load.", $tags="", $link="")
  }

  Container(Voics.sfu, "sfu", $techn="Rust, str0m", $descr="Home-grown selective forwarding unit: ICE-lite, DTLS-SRTP, simulcast/SVC layer selection, RTP rewrite, RTCP/BWE.", $tags="", $link="")
  ContainerDb(Voics.etcd, "etcd", $techn="etcd 3.6", $descr="Voice-server discovery under leased keys.", $tags="", $link="")
}

Rel(Voics.voicesignaling.Voicesocket, Voics.voicesignaling.Voicecodec, "Decodes/encodes frames with", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.Voicesocket, Voics.voicesignaling.Voicesession, "Starts one per client", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.Voicesession, Voics.voicesignaling.Tokenverifier, "Verifies IDENTIFY token with", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.Voicesession, Voics.voicesignaling.Roomregistry, "Joins room in", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.Voicesession, Voics.voicesignaling.DAVErelay, "Relays op 21-31 via", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.Voicesession, Voics.voicesignaling.SFUcontrolclient, "create_session, set_sink_wants", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.Voicesession, Voics.voicesignaling.Draincontroller, "Checks admission with", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.SFUsupervisor, Voics.voicesignaling.SFUcontrolclient, "Reconnects and replays sessions via", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.etcdregistrar, Voics.voicesignaling.Roomregistry, "Reports user count from", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.Draincontroller, Voics.voicesignaling.etcdregistrar, "Publishes draining flag via", $techn="", $tags="", $link="")
Rel(Voics.voicesignaling.SFUcontrolclient, Voics.sfu, "NDJSON commands", $techn="TCP 127.0.0.1:4101", $tags="", $link="")
Rel(Voics.voicesignaling.etcdregistrar, Voics.etcd, "Lease + key", $techn="gRPC", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml