@startuml
title <size:24>Component View: Voics - Desktop client</size>\n<size:24>Desktop client components.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("Voics_boundary", "Voics", $tags="") {
  Container_Boundary("Voics.Desktopclient_boundary", "Desktop client", $tags="") {
    Component(Voics.Desktopclient.Mainprocess, "Main process", $techn="Electron main", $descr="Window lifecycle, tray, global hotkeys, voics:// deep links, notifications, single instance.", $tags="", $link="")
    Component(Voics.Desktopclient.Autoupdater, "Auto-updater", $techn="electron-updater", $descr="Checks the update feed and installs new versions.", $tags="", $link="")
    Component(Voics.Desktopclient.Capturepicker, "Capture picker", $techn="desktopCapturer", $descr="Screen/window/app capture with Windows loopback audio and quality presets.", $tags="", $link="")
    Component(Voics.Desktopclient.Preloadbridge, "Preload bridge", $techn="contextBridge", $descr="Typed, minimal IPC surface exposed to the sandboxed renderer.", $tags="", $link="")
    Component(Voics.Desktopclient.Featureslices, "Feature slices", $techn="React, feature-sliced", $descr="Guilds, chat, DMs, voice stage, settings, server settings, command palette.", $tags="", $link="")
    Component(Voics.Desktopclient.Stores, "Stores", $techn="Zustand, TanStack Query", $descr="Client state fed by gateway dispatches; REST cache.", $tags="", $link="")
    Component(Voics.Desktopclient.RESTclient, "REST client", $techn="TypeScript", $descr="Typed client generated from contracts; rate-limit aware.", $tags="", $link="")
    Component(Voics.Desktopclient.Gatewayclient, "Gateway client", $techn="WebSocket", $descr="Heartbeat, resume, reconnect with backoff, op 20/21/22 handling.", $tags="", $link="")
    Component(Voics.Desktopclient.Voiceclient, "Voice client", $techn="WebRTC", $descr="Voice WebSocket, local SDP synthesis, simulcast, DAVE frame E2EE, RNNoise, VAD/PTT.", $tags="", $link="")
    Component(Voics.Desktopclient.Ephemeralmode, "Ephemeral mode", $techn="TypeScript", $descr="MLS group per chat; encrypts/decrypts E2EE envelopes.", $tags="", $link="")
    Component(Voics.Desktopclient.P2Pmode, "P2P mode", $techn="WebRTC", $descr="WebRTC data channels; identity-signed DTLS fingerprints.", $tags="", $link="")
    Component(Voics.Desktopclient.Nativecrypto, "Native crypto", $techn="Rust, napi-rs", $descr="OpenMLS, Ed25519 identity keys, SQLCipher local history, OS keychain.", $tags="", $link="")
  }

  Container(Voics.voicesignaling, "voice-signaling", $techn="Elixir, Phoenix", $descr="Voice WebSocket, media setup, speaking indicators, DAVE MLS relay, etcd registration, SFU supervision.", $tags="", $link="")
  Container(Voics.sfu, "sfu", $techn="Rust, str0m", $descr="Home-grown selective forwarding unit: ICE-lite, DTLS-SRTP, simulcast/SVC layer selection, RTP rewrite, RTCP/BWE.", $tags="", $link="")
  ContainerDb(Voics.MinIO, "MinIO", $techn="MinIO (S3 API)", $descr="Assets, attachments and the client update feed.", $tags="", $link="")
  Container(Voics.coturn, "coturn", $techn="coturn", $descr="TURN relay for P2P data channels when NAT requires it (never for voice).", $tags="", $link="")
  Container(Voics.api, "api", $techn="Rust, Axum, SQLx", $descr="Auth, users, devices, relationships, guilds, channels, roles, permissions, invites, bots, interactions, webhooks, MLS key packages, admin endpoints; transactional outbox.", $tags="", $link="")
  Container(Voics.messages, "messages", $techn="Rust, Axum, scylla driver", $descr="Standard message CRUD and history, Snowflake IDs, request coalescing, reactions, pins, read states, attachments.", $tags="", $link="")
  Container(Voics.gateway, "gateway", $techn="Elixir, Phoenix, libcluster", $descr="Client WebSocket protocol, sessions, guild processes, presence, typing, fan-out, E2EE relay, P2P signaling, voice allocation.", $tags="", $link="")
}

Rel(Voics.api, Voics.MinIO, "Presigns asset uploads", $techn="S3", $tags="", $link="")
Rel(Voics.api, Voics.messages, "Last message ids", $techn="HTTP /internal/v1", $tags="", $link="")
Rel(Voics.messages, Voics.MinIO, "Presigns attachment uploads", $techn="S3", $tags="", $link="")
Rel(Voics.messages, Voics.api, "Channel access, bot token introspection", $techn="HTTP /internal/v1", $tags="", $link="")
Rel(Voics.gateway, Voics.api, "Ready payload, guild state, access, introspect", $techn="HTTP /internal/v1", $tags="", $link="")
Rel(Voics.gateway, Voics.messages, "Last message ids", $techn="HTTP /internal/v1", $tags="", $link="")
Rel(Voics.voicesignaling, Voics.sfu, "Controls sessions", $techn="NDJSON over TCP 127.0.0.1:4101", $tags="", $link="")
Rel(Voics.Desktopclient.Mainprocess, Voics.Desktopclient.Autoupdater, "Starts", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Mainprocess, Voics.Desktopclient.Capturepicker, "Opens on screen-share request", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Mainprocess, Voics.Desktopclient.Preloadbridge, "Exposes IPC through", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Featureslices, Voics.Desktopclient.Preloadbridge, "Calls native features through", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Featureslices, Voics.Desktopclient.Stores, "Reads/writes", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Stores, Voics.Desktopclient.RESTclient, "Fetches via", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Gatewayclient, Voics.Desktopclient.Stores, "Feeds dispatches into", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Featureslices, Voics.Desktopclient.Voiceclient, "Joins calls with", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Featureslices, Voics.Desktopclient.Ephemeralmode, "Sends ephemeral messages with", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Featureslices, Voics.Desktopclient.P2Pmode, "Sends P2P messages with", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Ephemeralmode, Voics.Desktopclient.Gatewayclient, "Sends op 20/21 through", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.P2Pmode, Voics.Desktopclient.Gatewayclient, "Signals via op 22 through", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Ephemeralmode, Voics.Desktopclient.Nativecrypto, "MLS operations, local history", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.P2Pmode, Voics.Desktopclient.Nativecrypto, "Identity signatures, local history", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Voiceclient, Voics.Desktopclient.Nativecrypto, "DAVE key derivation", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Voiceclient, Voics.Desktopclient.Capturepicker, "Gets capture streams from", $techn="", $tags="", $link="")
Rel(Voics.Desktopclient.Autoupdater, Voics.MinIO, "Downloads updates from", $techn="HTTPS", $tags="", $link="")
Rel(Voics.Desktopclient.RESTclient, Voics.api, "Calls", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Voics.Desktopclient.RESTclient, Voics.messages, "Calls", $techn="HTTPS/JSON", $tags="", $link="")
Rel(Voics.Desktopclient.Gatewayclient, Voics.gateway, "Connects to", $techn="WSS", $tags="", $link="")
Rel(Voics.Desktopclient.Voiceclient, Voics.voicesignaling, "Connects to", $techn="WSS", $tags="", $link="")
Rel(Voics.Desktopclient.Voiceclient, Voics.sfu, "Streams media to", $techn="DTLS-SRTP/UDP", $tags="", $link="")
Rel(Voics.Desktopclient.P2Pmode, Voics.coturn, "Relays through when needed", $techn="TURN", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml